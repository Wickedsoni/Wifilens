    <!-- Glossary -->
    <string name="more_glossary_search">Search</string>
    <string name="more_glossary_rssi" translatable="false">RSSI</string>
    <string name="more_glossary_rssi_def">Received Signal Strength Indicator: how strong a Wi-Fi signal is, in dBm.</string>
    <string name="more_glossary_dbm" translatable="false">dBm</string>
    <string name="more_glossary_dbm_def">Decibel-milliwatts, the unit RSSI is measured in. Closer to 0 is stronger.</string>
    <string name="more_glossary_ssid" translatable="false">SSID</string>
    <string name="more_glossary_ssid_def">The network name you see when choosing a Wi-Fi network.</string>
    <string name="more_glossary_bssid" translatable="false">BSSID</string>
    <string name="more_glossary_bssid_def">The hardware address of one access-point radio, unique per band.</string>
    <string name="more_glossary_band">Band</string>
    <string name="more_glossary_band_def">A frequency range Wi-Fi uses: 2.4 GHz, 5 GHz or 6 GHz.</string>
    <string name="more_glossary_channel">Channel</string>
    <string name="more_glossary_channel_def">A slice of a band that a network transmits on.</string>
    <string name="more_glossary_channel_width">Channel width</string>
    <string name="more_glossary_channel_width_def">How much spectrum a channel uses. Wider is faster but more crowded.</string>
    <string name="more_glossary_co_channel">Co-channel interference</string>
    <string name="more_glossary_co_channel_def">Slowdown from another network using exactly the same channel.</string>
    <string name="more_glossary_congestion">Congestion score</string>
    <string name="more_glossary_congestion_def">How crowded a channel is, from 0 (clear) to 100 (crowded).</string>
    <string name="more_glossary_path_loss">Path loss</string>
    <string name="more_glossary_path_loss_def">Signal strength lost as it travels from the router to a device.</string>
    <string name="more_glossary_path_loss_exponent">Path-loss exponent</string>
    <string name="more_glossary_path_loss_exponent_def">How fast signal fades with distance. Higher means denser obstacles.</string>
    <string name="more_glossary_wall_attenuation">Wall attenuation</string>
    <string name="more_glossary_wall_attenuation_def">Signal lost passing through a wall, depending on its material.</string>
    <string name="more_glossary_measured_predicted">Measured vs predicted</string>
    <string name="more_glossary_measured_predicted_def">Measured comes from a live scan; predicted comes from your floor plan.</string>
