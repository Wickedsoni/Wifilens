<?xml version="1.0" encoding="utf-8"?>
<!-- TODO: Run Tools → Image Asset in Android Studio to generate
     legacy PNG mipmaps (mipmap-mdpi through mipmap-xxxhdpi)
     after updating this file. Use "Legacy" icon type.
     (Only matters if minSdk is ever lowered below 26 — at minSdk 26 every device uses the
     adaptive icon, and the existing mipmap-*dpi .webp files are never shown.) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Scaled to 90% about the centre so the outer arc's round caps stay inside the 66dp
         adaptive-icon safe zone (unscaled they reach ~36dp from centre and clip on circle masks). -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.9"
        android:scaleY="0.9">
        <!-- Base dot -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M49,72a5,5 0,1 0,10 0a5,5 0,1 0,-10 0z" />
        <!-- Arcs: centre (54,72), 210° -> 330° (the 120° span over the top), thinner outward. -->
        <path
            android:pathData="M40.14,64A16,16 0,0 1,67.86,64"
            android:strokeWidth="4"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round" />
        <path
            android:pathData="M29.75,58A28,28 0,0 1,78.25,58"
            android:strokeWidth="3.5"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round" />
        <path
            android:pathData="M19.36,52A40,40 0,0 1,88.64,52"
            android:strokeWidth="3"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round" />
    </group>
</vector>
